			"contents": "' Funzione per aprire una finestra di dialogo di selezione file\nPublic Function ApriFinestraSelezioneFile(Optional multiSelect As Boolean = False, Optional filter As String = \"Tutti i file (*.*)|*.*\", Optional titolo As String = \"Seleziona un file\") As Variant\n    Dim ofn As OPENFILENAME\n    Dim sFileName As String\n    Dim result As Long\n    Dim initialDir As String\n    Dim fileName As String\n\n    ' Imposta la path e il nome del file\n    initialDir = \"C:\\GESTIONI\\GESTIONE_LLPP\\25_GESTIONE_LLPP\\LLPP_ARCHIVI_MDB\\IMPEGNI\\\"\n    fileName = \"Project_IMPEGNI_DI_SPESA.sublime-project\"\n\n    ' Inizializza il buffer per il nome del file\n    sFileName = initialDir & fileName\n\n    ' Configura la finestra di dialogo\n    ofn.lStructSize = Len(ofn)\n    ofn.hwndOwner = Application.hWndAccessApp\n    ofn.lpstrFilter = ConvertFilter(filter)\n    ofn.lpstrFile = sFileName\n    ofn.nMaxFile = Len(sFileName)\n    ofn.lpstrTitle = titolo\n    ofn.lpstrInitialDir = initialDir  ' Imposta la cartella iniziale\n    ofn.Flags = IIf(multiSelect, 0, 0) ' Flags per supportare eventuali opzioni future\n\n    ' Mostra la finestra di dialogo\n    result = GetOpenFileName(ofn)\n\n    ' Restituisce il file selezionato o un array di file\n    If result <> 0 Then\n        Dim selectedFiles As String\n        selectedFiles = Left(ofn.lpstrFile, InStr(ofn.lpstrFile, Chr(0)) - 1)\n        ApriFinestraSelezioneFile = Split(selectedFiles, vbNullChar)\n    Else\n        ApriFinestraSelezioneFile = Null\n    End If\nEnd Function\n\n' Converti il filtro in un formato compatibile con l'API\nPrivate Function ConvertFilter(filter As String) As String\n    ConvertFilter = Replace(filter, \"|\", Chr(0)) & Chr(0)\nEnd Function\n\n' Implementazione di Cmd_FILTER_Click\nPrivate Sub Cmd_FILTER_Click()\n    On Error GoTo Err_Handler\n\n    Dim result As Variant\n    result = ApriFinestraSelezioneFile(False, \"Immagini (*.gif;*.jpg;*.jpeg)|*.gif;*.jpg;*.jpeg\", \"Seleziona un'immagine\")\n    If Not IsNull(result) Then\n        MsgBox \"File selezionato: \" & result(0)\n    Else\n        MsgBox \"Nessun file selezionato.\"\n    End If\n\nExit_Handler:\n    Exit Sub\n\nErr_Handler:\n    MsgBox Err.Description\n    Resume Exit_Handler\nEnd Sub\n",
